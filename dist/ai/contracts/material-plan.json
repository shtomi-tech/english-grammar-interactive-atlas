    "sourceProblemSelection"
  ],
  "selectionFields": [
    "query",
    "selected"
  ],
  "selectedInteractionFields": [
    "canonicalRef",
    "rank",
    "score",
    "reasons"
  ],
  "selectedProblemFields": [
    "canonicalRef",
    "rank",
    "score",
    "reasons"
