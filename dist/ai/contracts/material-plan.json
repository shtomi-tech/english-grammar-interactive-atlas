  "optionalFields": [],
  "fieldDefinitions": {
    "version": {
      "type": "string",
      "required": true,
      "allowedValues": [
        "1"
      ],
      "description": "Material Plan contract version."
    },
    "id": {
      "type": "string",
      "required": true,
      "description": "Stable identifier for one material plan."
    },
    "learningRequirementsRef": {
      "type": "object",
      "required": true,
      "fields": [
        "id",
        "version"
      ],
      "description": "Reference to the source Learning Requirements document."
    },
    "items": {
      "type": "array",
      "required": true,
      "itemFields": [
        "id",
        "learningPointId",
        "interactionSelection",
        "problemDecision",
        "rationale"
      ],
      "description": "One planned learning activity per item."
    },
    "interactionSelection": {
      "type": "object",
      "required": true,
      "fields": [
        "query",
        "selected"
      ],
      "description": "Retrieval query and evidence for the selected Interaction."
    },
    "problemDecision": {
      "type": "object",
      "required": true,
      "fields": [
        "action",
        "reason",
        "problemSelection",
        "sourceProblemSelection"
      ],
      "allowedValues": [
        "reuse",
        "adapt",
        "generate",
        "unresolved"
      ],
      "description": "Decision to reuse, adapt, generate, or leave unresolved."
    }
  },
  "actionValues": [
    "reuse",
    "adapt",
    "generate",
    "unresolved"
  ],
